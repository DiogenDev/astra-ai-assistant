DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Set a random token here AND in the VS Code setting `aiAssistant.authToken`.
# Leave empty to disable auth (loopback only).
AUTH_TOKEN=
HOST=127.0.0.1
PORT=8765
MAX_AGENT_STEPS=6
ASSISTANT_NAME=GPT 6 Astra

# Optional price overrides, USD per 1M tokens (defaults = DeepSeek V4.1 Flash,
# automatic peak/off-peak). Peak: 01:00-04:00 and 06:00-10:00 UTC, Mon-Fri.
# PRICE_CACHE_HIT_PER_M=
# PRICE_CACHE_MISS_PER_M=
# PRICE_OUTPUT_PER_M=
REASONING_EFFORT=medium

# auto | deepseek | free
PROVIDER=auto
# Free providers:
#   freedeepseek - FreeDeepseekAPI proxy from DeepSeek Web (main method)
#   google       - opens Google AI Mode in the browser (no key)
#   gemini       - free key: https://aistudio.google.com/apikey
#   openrouter   - free key: https://openrouter.ai/keys
#   groq         - free key: https://console.groq.com/keys
#   ollama       - local, no key: https://ollama.com/download
#   pollinations - no key
#   openai       - any OpenAI-compatible FREE_BASE_URL
FREE_PROVIDER=freedeepseek
FREE_DEEPSEEK_URL=http://127.0.0.1:9655/v1
# FREE_API_KEY=
# FREE_MODEL=deepseek-chat
# FREE_BASE_URL=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# FREE_TIMEOUT=90
# CONTEXT_LIMIT=1000000
