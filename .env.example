DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Set a random token here AND in the VS Code setting `aiAssistant.authToken`.
# Leave empty to disable auth (loopback only).
AUTH_TOKEN=
HOST=127.0.0.1
PORT=8765
MAX_AGENT_STEPS=6
ASSISTANT_NAME=GPT 6 Astra

# Optional price overrides, USD per 1M tokens (defaults = DeepSeek V4.1 Flash,
# automatic peak/off-peak). Peak: 01:00-04:00 and 06:00-10:00 UTC, Mon-Fri.
# PRICE_CACHE_HIT_PER_M=
# PRICE_CACHE_MISS_PER_M=
# PRICE_OUTPUT_PER_M=
REASONING_EFFORT=medium
