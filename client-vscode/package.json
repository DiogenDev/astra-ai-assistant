{
  "name": "ai-assistant-deepseek",
  "displayName": "Astra AI Assistant",
  "description": "Copilot-style inline completions and an agentic chat panel powered by DeepSeek.",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The agent can read and modify workspace files, so the backend only starts in a trusted workspace."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiAssistant.openChat",
        "title": "AI: Open Chat"
      },
      {
        "command": "aiAssistant.explainSelection",
        "title": "AI: Explain Selection"
      },
      {
        "command": "aiAssistant.fixSelection",
        "title": "AI: Fix Selection"
      },
      {
        "command": "aiAssistant.runInlineRequest",
        "title": "AI: Run Inline Request"
      },
      {
        "command": "aiAssistant.setup",
        "title": "AI: Setup / Settings"
      },
      {
        "command": "aiAssistant.installDeps",
        "title": "AI: Install Backend Dependencies"
      }
    ],
    "keybindings": [
      {
        "command": "aiAssistant.runInlineRequest",
        "key": "ctrl+alt+enter",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiAssistant",
          "title": "AI Assistant",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiAssistant": [
        {
          "id": "aiAssistant.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "AI Assistant",
      "properties": {
        "aiAssistant.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to start the backend."
        },
        "aiAssistant.backendRoot": {
          "type": "string",
          "default": "",
          "description": "Folder containing the `backend` package and `.env`. Auto-detected in dev mode; set it when the extension is installed as a VSIX."
        },
        "aiAssistant.autoStartBackend": {
          "type": "boolean",
          "default": true,
          "description": "Spawn the Python backend automatically. Disable when the backend runs in Docker."
        },
        "aiAssistant.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Backend base URL."
        },
        "aiAssistant.port": {
          "type": "number",
          "default": 8765,
          "description": "Port for the spawned backend."
        },
        "aiAssistant.authToken": {
          "type": "string",
          "default": "",
          "description": "Must match AUTH_TOKEN in .env. Leave empty to disable auth."
        },
        "aiAssistant.enableInline": {
          "type": "boolean",
          "default": true,
          "description": "Enable ghost-text inline completions."
        },
        "aiAssistant.inlineRequest.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline requests written in comments like `# ai: ...`."
        },
        "aiAssistant.inlineRequest.auto": {
          "type": "boolean",
          "default": true,
          "description": "Run inline requests automatically after the idle delay."
        },
        "aiAssistant.inlineRequest.idleDelayMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "description": "How long you must stop typing before an inline request runs (ms)."
        },
        "aiAssistant.autoStartFreeAi": {
          "type": "boolean",
          "default": true,
          "description": "Start the FreeDeepseekAPI proxy automatically when the extension activates (regardless of the chat provider)."
        },
        "aiAssistant.freeDeepseekRoot": {
          "type": "string",
          "default": "",
          "description": "Folder containing FreeDeepseekAPI (server.js). Empty = %USERPROFILE%\\Documents\\GitHub\\FreeDeepseekAPI."
        },
        "aiAssistant.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used to start the FreeDeepseekAPI proxy."
        },
        "aiAssistant.provider": {
          "type": "string",
          "enum": [
            "auto",
            "deepseek",
            "free"
          ],
          "enumDescriptions": [
            "DeepSeek if a key is configured, otherwise the free provider.",
            "Always use DeepSeek (requires DEEPSEEK_API_KEY).",
            "Always use the free provider: GPT 5.6 Terra, no conversation memory."
          ],
          "default": "auto",
          "description": "Which backend to use for the chat."
        },
        "aiAssistant.freeProvider": {
          "type": "string",
          "enum": [
            "freedeepseek",
            "google",
            "gemini",
            "openrouter",
            "groq",
            "ollama",
            "pollinations",
            "openai"
          ],
          "default": "freedeepseek",
          "description": "Free provider used when the chat provider is free."
        },
        "aiAssistant.contextLimit": {
          "type": "number",
          "default": 1000000,
          "description": "Context window limit in tokens, used by the Context panel."
        },
        "aiAssistant.reasoningEffort": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "low",
            "medium",
            "high"
          ],
          "enumDescriptions": [
            "Use the provider default (thinking enabled).",
            "Disable reasoning for the fastest answers.",
            "Light reasoning.",
            "Balanced reasoning.",
            "Deep reasoning (slowest, most tokens)."
          ],
          "default": "medium",
          "description": "Reasoning effort for chat and the agent."
        },
        "aiAssistant.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "DeepSeek model used by the backend (deepseek-flash or deepseek-v4-pro)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "tsc -p ./",
    "test": "node --test",
    "prepackage": "node scripts/prepare-vsix.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies --out ai-assistant.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0"
  }
}
